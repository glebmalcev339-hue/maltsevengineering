# Maltsev Engineering — базовые настройки (Apache)
AddDefaultCharset UTF-8

# Сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

# Кеширование статики
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType application/manifest+json "access plus 7 days"
</IfModule>

# Приватные файлы — никогда не отдавать
<Files "ADMIN_ACCESS.txt">
  Require all denied
</Files>
<FilesMatch "\.(sqlite3|bat|py)$">
  Require all denied
</FilesMatch>

